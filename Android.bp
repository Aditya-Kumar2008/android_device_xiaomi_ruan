soong_namespace {
    imports: [
        "hardware/google/interfaces",
        "hardware/google/pixel/pixelstats",
        "hardware/google/pixel/power-libperfmgr",
        "hardware/lineage/interfaces/power-libperfmgr",
        "hardware/qcom-caf/common/libqti-perfd-client",
        "hardware/xiaomi",
        "vendor/qcom/opensource/commonsys-intf/display",
    ],
}

// ruan's WCN6750 runs the qca6750 flavour of qca_cld3 (the adrastea and
// qca6490 modules fail to probe), which reads its files from qca6750/.
install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6750/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/wlan/wlan_mac.bin",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6750/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/qca6750/WCNSS_qcom_cfg.ini",
}

// The Flex clock plugin (vendor/extras) targets a ClockProviderPlugin
// version the Pixel WallpaperPickerGoogleRelease lacks: "Wallpaper & style"
// crashes on launch while it is installed. Keep it off ruan.
prebuilt_etc {
    name: "ruan_no_flex_clock",
    src: "configs/overrides/no-flex-clock.txt",
    system_ext_specific: true,
    overrides: ["SystemUIClocks-Flex"],
}
