<?xml version="1.0" encoding="UTF-8"?>

<!-- Device : Redmi Pad Pro 5G / POCO Pad 5G (ruan) -->
<!-- PenguinOS 17: repo init -u https://github.com/Project-PenguinOS/manifest -b celerity
     first, then put this in .repo/local_manifests/ and repo sync.
     Build: apply the patches in patches/ (build/make, frameworks/*, vendor/aospa),
     then lunch aospa_ruan-userdebug && m bacon -->

<manifest>
  <!-- Remotes -->
  <remote name="ruan-dev" fetch="https://github.com/Aditya-Kumar2008/" />
  <remote name="evo-devices" fetch="https://github.com/Evolution-X-Devices/" />
  <remote name="github-non-los" fetch="https://github.com/" />
  <remote name="nekoshirro" fetch="https://github.com/nekoshirro/" />

  <!-- Device tree -->
  <project path="device/xiaomi/ruan" name="android_device_xiaomi_ruan" remote="ruan-dev" revision="penguinos-17" />

  <!-- Prebuilt stock vendor modules, dtb (+ stock Image as fallback) -->
  <project path="device/xiaomi/ruan-kernel" name="device_xiaomi_ruan-kernel" remote="ruan-dev" revision="infinityx" />

  <!-- Vendor blobs (from ruan HyperOS OS3.0.303.0.WFSMIXM) -->
  <project path="vendor/xiaomi/ruan" name="android_vendor_xiaomi_ruan" remote="ruan-dev" revision="infinityx-16" />

  <!-- Kernel source for techpack UAPI headers (headers-only usage) -->
  <project path="kernel/xiaomi/sm7435" name="kernel_xiaomi_garnet" remote="evo-devices" revision="bka" clone-depth="1" />
  <project path="kernel/xiaomi/sm7435-modules" name="kernel_xiaomi_garnet-modules" remote="evo-devices" revision="bka" clone-depth="1" />

  <!-- Lineage qcom-caf common (device.mk inherits hardware/qcom-caf/common/common.mk) -->
  <project path="hardware/qcom-caf/common" name="LineageOS/android_hardware_qcom-caf_common" remote="github-non-los" revision="lineage-24.0" />

  <!-- Xiaomi hardware (touch, pen, sensors interfaces) -->
  <project path="hardware/xiaomi" name="LineageOS/android_hardware_xiaomi" remote="github-non-los" revision="lineage-24.0" />

  <!-- Dolby -->
  <project path="hardware/dolby" name="android_hardware_dolby" remote="nekoshirro" revision="lunaris" />
</manifest>
