From 0771ce45bf7bae7b08b32934531eb1aadf47c385 Mon Sep 17 00:00:00 2001
From: Alexander Gurov <aliogu23@gmail.com>
Date: Sun, 27 Sep 2026 22:30:09 +0300
Subject: [PATCH] renderengine: Force realtime Vulkan queue priority when
 unqueried

Adreno drivers (dizi's V@0615.98) expose VK_EXT_global_priority but
not VK_EXT_global_priority_query, so RenderEngine can't learn what
priority it was granted and the Vulkan queue was left at MEDIUM,
behind app GPU work, while GL RE gets realtime priority on the same
device.

When the query gave no answer, retry device creation requesting
REALTIME, then HIGH, then MEDIUM, stepping down only on
VK_ERROR_NOT_PERMITTED, and set mIsRealtimePriority from the level
actually obtained instead of assuming MEDIUM.

Measured on dizi (QS pulldown, Graphite RE): cold-start jank
11.9% -> 5.8%, warm at GL parity (~5.3%).

Claude-Session: https://claude.ai/code/session_01YZrxbgb9k1nNzQwMqEHGyo
---
 libs/renderengine/skia/VulkanInterface.cpp | 25 +++++++++++++++++++++-
 1 file changed, 24 insertions(+), 1 deletion(-)

diff --git a/libs/renderengine/skia/VulkanInterface.cpp b/libs/renderengine/skia/VulkanInterface.cpp
index 115acea..e27d362 100644
--- a/libs/renderengine/skia/VulkanInterface.cpp
+++ b/libs/renderengine/skia/VulkanInterface.cpp
@@ -514,7 +514,30 @@ void VulkanInterface::init(bool protectedContent) {
 
     ALOGD("Trying to create Vk device with protectedContent=%d", protectedContent);
     VkDevice device;
-    VK_CHECK(vkCreateDevice(physicalDevice, &deviceInfo, nullptr, &device));
+    if (queueNextPtr && queuePriority == VK_QUEUE_GLOBAL_PRIORITY_MEDIUM_KHR) {
+        // The driver didn't answer the global priority query (e.g. Adreno drivers that have
+        // VK_EXT_global_priority but not VK_EXT_global_priority_query), so the queue would be
+        // stuck at MEDIUM, behind app GPU work. GL RE gets realtime priority on the same GPU,
+        // so ask for it and step down if the driver refuses.
+        const VkQueueGlobalPriorityKHR candidates[] = {VK_QUEUE_GLOBAL_PRIORITY_REALTIME_KHR,
+                                                       VK_QUEUE_GLOBAL_PRIORITY_HIGH_KHR,
+                                                       VK_QUEUE_GLOBAL_PRIORITY_MEDIUM_KHR};
+        VkResult result = VK_ERROR_INITIALIZATION_FAILED;
+        for (VkQueueGlobalPriorityKHR candidate : candidates) {
+            queuePriorityCreateInfo.globalPriority = candidate;
+            result = vkCreateDevice(physicalDevice, &deviceInfo, nullptr, &device);
+            if (result != VK_ERROR_NOT_PERMITTED_KHR) break;
+        }
+        if (result != VK_SUCCESS) {
+            BAIL("[vkCreateDevice] failed. err = %d", result);
+        }
+        mIsRealtimePriority =
+                queuePriorityCreateInfo.globalPriority == VK_QUEUE_GLOBAL_PRIORITY_REALTIME_KHR;
+        ALOGI("Vk device queue global priority %d (unqueried)",
+              queuePriorityCreateInfo.globalPriority);
+    } else {
+        VK_CHECK(vkCreateDevice(physicalDevice, &deviceInfo, nullptr, &device));
+    }
     ALOGD("Trying to create Vk device with protectedContent=%d (success)", protectedContent);
 
     VkQueue graphicsQueue;
-- 
