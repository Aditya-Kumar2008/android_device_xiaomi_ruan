From 4ee211d8cf87e0305b64e1bf328af8d8e6b5dbbe Mon Sep 17 00:00:00 2001
From: Alexander Gurov <aliogu23@gmail.com>
Date: Sat, 26 Sep 2026 23:12:48 +0300
Subject: [PATCH] gms: Match CrossDeviceAccessServicePrimary uses-library to
 its manifest

The APK only declares androidx.window.extensions and androidx.window.sidecar,
so manifest_check fails with org.apache.http.legacy listed as well.

Claude-Session: https://claude.ai/code/session_01YZrxbgb9k1nNzQwMqEHGyo
---
 .../packages/apps/CrossDeviceAccessServicePrimary/Android.mk    | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/system_ext/packages/apps/CrossDeviceAccessServicePrimary/Android.mk b/system_ext/packages/apps/CrossDeviceAccessServicePrimary/Android.mk
index 7201a39..ef253b7 100644
--- a/system_ext/packages/apps/CrossDeviceAccessServicePrimary/Android.mk
+++ b/system_ext/packages/apps/CrossDeviceAccessServicePrimary/Android.mk
@@ -24,6 +24,6 @@ LOCAL_SRC_FILES := CrossDeviceAccessServicePrimary.apk
 LOCAL_CERTIFICATE := platform
 LOCAL_MODULE_CLASS := APPS
 LOCAL_SYSTEM_EXT_MODULE := true
-LOCAL_OPTIONAL_USES_LIBRARIES := androidx.window.extensions androidx.window.sidecar org.apache.http.legacy
+LOCAL_OPTIONAL_USES_LIBRARIES := androidx.window.extensions androidx.window.sidecar
 LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
 include $(BUILD_PREBUILT)
-- 
2.47.3

