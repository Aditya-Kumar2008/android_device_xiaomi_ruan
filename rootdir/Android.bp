prebuilt_etc {
    name: "charger_fw_fstab.qti",
    src: "etc/charger_fw_fstab.qti",
    vendor: true,
}

prebuilt_etc {
    name: "fstab.qcom",
    src: "etc/fstab.qcom",
    vendor: true,
}

prebuilt_etc {
    name: "init.ruan.rc",
    src: "etc/init.ruan.rc",
    sub_dir: "init",
    vendor: true,
}

sh_binary {
    name: "init.ruan.usb_attach.sh",
    src: "bin/init.ruan.usb_attach.sh",
    vendor: true,
}

prebuilt_etc {
    name: "init.qcom.rc",
    src: "etc/init.qcom.rc",
    sub_dir: "init",
    vendor: true,
}

prebuilt_etc {
    name: "init.recovery.qcom.rc",
    src: "etc/init.recovery.qcom.rc",
    sub_dir: "init",
    recovery: true,
}

prebuilt_etc {
    name: "init.target.rc",
    src: "etc/init.target.rc",
    sub_dir: "init",
    vendor: true,
}

prebuilt_etc {
    name: "ueventd-odm.rc",
    src: "etc/ueventd-odm.rc",
    filename: "ueventd.rc",
    device_specific: true,
}

prebuilt_etc {
    name: "ueventd.qcom.rc",
    src: "etc/ueventd.qcom.rc",
    filename: "ueventd.rc",
    vendor: true,
}
