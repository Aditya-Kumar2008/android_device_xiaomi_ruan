# Audio
aaudio.hw_burst_min_usec=2000
aaudio.mmap_exclusive_policy=2
aaudio.mmap_policy=2
af.fast_track_multiplier=1
audio.deep_buffer.media=true
audio.offload.video=true
audio.spatializer.pose_predictor_type=2
audio.spatializer.prediction_duration_ms=50
persist.vendor.audio.auto.scenario=true
persist.vendor.audio.misound.disable=true
persist.vendor.audio.misoundasc=false
ro.af.client_heap_size_kbyte=7168
ro.audio.flinger_standbytime_ms=2000
ro.audio.monitorRotation=true
ro.config.alarm_vol_steps=15
ro.config.system_vol_steps=15
ro.config.vc_call_vol_steps=11
ro.vendor.audio.camera.loopback.support=false
ro.vendor.audio.feature.spatial=7
ro.vendor.audio.gain.support=true
ro.vendor.audio.soundtrigger.appdefine.cnn.level=45
ro.vendor.audio.soundtrigger.appdefine.gmm.level=65
ro.vendor.audio.soundtrigger.appdefine.gmm.user.level=55
ro.vendor.audio.soundtrigger.appdefine.vop.level=10
ro.vendor.audio.soundtrigger.xanzn.cnn.level=158
ro.vendor.audio.soundtrigger.xanzn.gmm.level=80
ro.vendor.audio.soundtrigger.xanzn.gmm.user.level=80
ro.vendor.audio.soundtrigger.xanzn.vop.level=41
ro.vendor.audio.soundtrigger.xatx.cnn.level=95
ro.vendor.audio.soundtrigger.xatx.gmm.level=54
ro.vendor.audio.soundtrigger.xatx.gmm.user.level=54
ro.vendor.audio.soundtrigger.xatx.vop.level=0
ro.vendor.audio.soundtrigger=sva
ro.vendor.audio.support.sound.id=true
vendor.audio.adm.buffering.ms=2
vendor.audio.feature.a2dp_offload.enable=true
vendor.audio.feature.afe_proxy.enable=true
vendor.audio.feature.battery_listener.enable=true
vendor.audio.feature.dmabuf.cma.memory.enable=true
vendor.audio.feature.hfp.enable=false
vendor.audio.feature.kpi_optimize.enable=true
vendor.audio.hdr.record.enable=false
vendor.audio.offload.buffer.size.kb=256
vendor.audio.safx.pbe.enabled=false
vendor.audio.ull_record_period_multiplier=2
vendor.audio.volume.headset.gain.depcal=true
vendor.audio_hal.period_size=192
vendor.qc2audio.per_frame.flac.dec.enabled=true
vendor.qc2audio.suspend.enabled=true

# Bluetooth
bluetooth.profile.asha.central.enabled=true
persist.bluetooth.a2dp_offload.disabled=false
persist.vendor.qcom.bluetooth.a2dp_mcast_test.enabled=false
persist.vendor.qcom.bluetooth.a2dp_offload_cap=sbc-aac-aptx-aptxhd-ldac
persist.vendor.qcom.bluetooth.aac_frm_ctl.enabled=true
persist.vendor.qcom.bluetooth.aptxadaptiver2_1_support=false
persist.vendor.qcom.bluetooth.aptxadaptiver2_2_support=false
persist.vendor.qcom.bluetooth.scram.enabled=false
persist.vendor.qcom.bluetooth.twsp_state.enabled=false
ro.bluetooth.a2dp_offload.supported=true
vendor.hw.fm.init=0

# Camera
# Hide the aux/logical cameras from normal apps, like stock: logical camera 2
# reports zoomRatioRange [FLT_MAX, 0] and crashes CameraX apps (Aperture).
persist.vendor.camera.privapp.list=org.codeaurora.snapcam
vendor.camera.aux.packagelist=com.xiaomi.runin,com.xiaomi.cameratest,com.xiaomi.factory.mmi,org.codeaurora.snapcam
vendor.camera.aux.packagelistext=com.xiaomi.factory.CameraTestItem
camera.disable_zsl_mode=true
ro.camera.enableCamera1MaxZsl=1
ro.hardware.camera=xiaomi
persist.vendor.camera.logLevel=0
persist.vendor.camera.sensor=0

# Chipset
ro.soc.manufacturer=QTI

# Dalvik
# Stock ruan's app heap limit. garnet's init.qcom.rc used to set 512m at
# runtime from vendor.display.lcd_density; the tablet makefile default is 192m.
dalvik.vm.heapgrowthlimit=256m

# Display (boot values)
# These replace CAF's init.qti.display_boot.sh (parrot, soc_id 638). As build.prop values
# they are set before the composer starts; overriding the script's values from
# init.ruan.rc raced with it (b27: the composer read enable_rotator_ui=1 again).
# enable_spec_fence=0: as Xiaomi's script. With 1 every commit waits an extra vsync.
# enable_rotator_ui=0: in landscape the rotated, zoomed wallpaper fails the inline
# rotator and the whole frame falls back to GPU composition.
vendor.display.disable_mitigated_fps=1
vendor.display.disable_non_wfd_vds=1
vendor.display.enable_allow_idle_fallback=1
vendor.display.enable_perf_hint_large_comp_cycle=1
vendor.display.enable_posted_start_dyn=2
vendor.display.enable_qsync_idle=1
vendor.display.enable_rc_support=1
vendor.display.enable_rotator_ui=0
vendor.display.enable_spec_fence=0
vendor.display.secure_preview_buffer_format=420_sp
vendor.display.target.version=2
vendor.display.thermal.version=1
vendor.gralloc.secure_preview_buffer_format=420_sp
vendor.gralloc.use_dma_buf_heaps=1

# Display
ro.vendor.display.sensortype=2
ro.vendor.display.svi=1
vendor.display.comp_mask=0
vendor.display.disable_3d_adaptive_tm=0
vendor.display.disable_excl_rect=0
vendor.display.disable_excl_rect_partial_fb=1
vendor.display.disable_hw_recovery_dump=1
vendor.display.disable_offline_rotator=1
vendor.display.disable_scaler=0
vendor.display.disable_sdr_dimming=1
vendor.display.disable_sdr_histogram=1
vendor.display.disable_stc_dimming=1
vendor.display.enable_async_powermode=0
vendor.display.enable_async_vds_creation=1
vendor.display.enable_dpps_dynamic_fps=0
vendor.display.enable_hdr10_gpu_target=1
vendor.display.enable_optimize_refresh=0
vendor.display.enable_rounded_corner=1
vendor.display.idle_time=0
vendor.display.override_doze_mode=1
vendor.display.vds_allow_hwc=0

# DPM
persist.vendor.dpm.vndr.feature=1
persist.vendor.dpm.vndr.halservice.enable=1
persist.vendor.dpm.vndr.idletimer.mode=default

# FUSE
persist.sys.fuse.passthrough.enable=true

# Gatekeeper
vendor.gatekeeper.disable_spu=true

# Graphics
debug.hwui.skia_atrace_enabled=false
# ADPF: HWUI reports frame durations to the power HAL (hint sessions).
debug.hwui.use_hint_manager=true
debug.sf.disable_client_composition_cache=0
# SurfaceFlinger work durations: two 120 Hz frames for apps and for SF (was 13.7/12.3 ms).
# Recents->app janky 7.0%/11.5% (launcher/display) -> 4.7%/10.1%, QS 3.6% -> 2.8%, for ~3-4 ms
# more touch-to-display latency (research/performance-report.md).
debug.sf.early.app.duration=16666666
debug.sf.early.sf.duration=16666666
debug.sf.earlyGl.app.duration=16666666
debug.sf.earlyGl.sf.duration=16666666
debug.sf.enable_gl_backpressure=0
debug.sf.enable_hwc_vds=1
debug.sf.enable_transaction_tracing=false
debug.sf.hw=0
debug.sf.latch_unsignaled=0
debug.sf.late.app.duration=16666666
debug.sf.late.sf.duration=16666666
debug.sf.layer_caching_active_layer_timeout_ms=1000
debug.sf.predict_hwc_composition_strategy=0
debug.sf.set_idle_timer_ms=1100
debug.sf.treat_170m_as_sRGB=1
debug.sf.use_phase_offsets_as_durations=1
debug.sf.defer_refresh_rate_when_off=1
debug.sf.enable_egl_image_tracker=0
persist.sys.sf.color_mode=0
persist.sys.sf.color_saturation=1.0
persist.sys.sf.native_mode=258
ro.hardware.egl=adreno
ro.hardware.vulkan=adreno
ro.opengles.version=196610
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.game_default_frame_rate_override=120
ro.surface_flinger.has_HDR_display=true
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.max_virtual_display_dimension=4096
ro.surface_flinger.protected_contents=true
ro.surface_flinger.set_touch_timer_ms=200
ro.surface_flinger.supports_background_blur=1
ro.surface_flinger.use_color_management=true
ro.surface_flinger.use_content_detection_for_refresh_rate=true
ro.surface_flinger.wcg_composition_dataspace=142671872
vendor.gralloc.disable_ubwc=0

# Keystore
ro.hardware.keystore_desede=true

# LMK
ro.config.low_ram=false

# Media
debug.c2.use_dmabufheaps=1
debug.stagefright.c2inputsurface=-1
debug.sdm.support_writeback=0
ro.media.xml_variant.profiles=_parrot_v0

# Media (Dolby)
ro.vendor.audio.dolby.dax.support=true
ro.vendor.audio.dolby.surround.enable=true

# Perf
ro.vendor.extension_library=libqti-perfd-client.so
vendor.perf.framepacing.enable=1

# Qcomd
persist.vendor.qcomsysd.enabled=1

# RCS
persist.vendor.rcs.singlereg.feature=1

# USB
sys.usb.mtp.batchcancel=1
vendor.usb.diag.func.name=ffs
vendor.usb.dpl.inst.name=dpl
vendor.usb.qdss.inst.name=qdss_sw
vendor.usb.rmnet.func.name=gsi
vendor.usb.rmnet.inst.name=rmnet
vendor.usb.rndis.func.name=gsi
vendor.usb.use_ffs_mtp=1
vendor.usb.use_gadget_hal=1

# VCB
persist.vendor.vcb.enable=false

# WLAN
wifi.aware.interface=wifi-aware0
