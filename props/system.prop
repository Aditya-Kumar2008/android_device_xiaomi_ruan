# CNE
persist.vendor.cne.feature=1

# ro.product.mod_device is set per-SKU in props/odm/<sku>_build.prop.

# QTI
ro.vendor.qti.va_aosp.support=1

# Radio
DEVICE_PROVISIONED=1
persist.vendor.data.mode=concurrent
persist.vendor.vonr_setting_support=1
ril.subscription.types=NV,RUIM
ro.telephony.default_network=33,33
telephony.lteOnCdmaDevice=1

# RIL Powersaving
persist.radio.add_power_save=1
pm.sleep_mode=1
ro.ril.disable.power.collapse=0
ro.ril.fast.dormancy.rule=1
ro.ril.fast.dormancy.timeout=3
ro.mot.eri.losalert.delay=100
ro.vendor.use_data_netmgrd=true
ro.vold.umsdirtyratio=20
power.saving.mode=1

# Device name is set per-SKU in props/odm/<sku>_build.prop (imported by
# odm.prop), because ruan ships as both "Redmi Pad Pro 5G" and "POCO Pad 5G".
# Do not set it here: system/build.prop loads first and ro.* is write-once, so
# a value here would shadow the SKU-specific one.

# Force Vulkan rendering (HWUI + SurfaceFlinger). RenderEngine must be
# *threaded; the non-threaded backends are rejected at runtime.
debug.hwui.renderer=skiavk
debug.renderengine.backend=skiavkthreaded
ro.hwui.use_vulkan=1

# Dual physical SIM slots; framework default is 1, which makes UiccController
# index mUiccSlots[slotId] past the end when the modem reports slot_id 1.
ro.telephony.sim_slots.count=2
